{
        "name": "Google Translate",
        "scope": ["https\\:\\/\\/translate\\.google\\.com"],
        "plugins": [
            {"name": "GoogleAuthentication"},
            {"name": "WebRTC"},
            {"name": "Notifications"},
            {"name": "ChangeUserAgent", "user-agent": "chrome"},
            {"name": "TrayIcon"},
            {"name": "SingleInstance"}
